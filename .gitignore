# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/
**/.DS_Store

# Scratch and exploratory work
**/scrap/
qual_tries/

# Generated figures: notebooks recreate them. Hand-made figures live in static_figures/.
satellite/plots/
sci_fund_real/plots/
study_comparison/plots/
explain_divergence/plots/

# Generated tables: notebooks (and sci_fund_real/hte_grf.R) recreate them.
satellite/tables/
sci_fund_real/tables/
study_comparison/tables/
explain_divergence/tables/

# Frozen BERTopic runs. Only the two runs the theme tables are transcribed from are
# tracked; the notebooks skip refitting when their own frozen run is present.
**/text_analysis_freeze/*
!satellite/text_analysis_freeze/bertopic_topic_summary_20260908_170416.txt
!sci_fund_real/text_analysis_freeze/bertopic_topic_summary_20260912_144452.txt

