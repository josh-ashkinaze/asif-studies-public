main.aux
main.bbl
main.blg
main.fdb_latexmk
main.fls
main.log
main.out
main.pdf

# Manuscript QA scratch
manuscript_qa/

# Raw survey exports. These carry Qualtrics/Prolific direct identifiers (IP address,
# geolocation, Prolific ID) for every response. Re-download from Qualtrics when needed; the
# committed clean files are stripped of identifiers by scripts/strip_identifiers.py.
# Leading **/ so these match at any depth; a bare */ matches only one level.
**/raw/
**/data/qualtrics/
**/data/qualtrics_experiment/
**/AIM*.csv
**/AIM?project*.csv

# Private working notes
working.md
revision_changes.md

# Stray generated plots outside the per-study plot folders
Rplots.pdf
study_comparison_adjusted.pdf
study_comparison_forest_adjusted.pdf

# LaTeX sync artifact
main.synctex.gz

# Exploratory feature search, kept untracked
explain_divergence/linguistic_specification_search/

# Licensed LIWC dictionaries — never commit
*.dic

# Prolific demographic exports and raw app-database dumps carry Prolific IDs and intake answers.
# Only get_data.py reads them, to rebuild the clean data; keep local copies, never commit them.
**/data/demo_data/
sci_fund_real/data/*.json
