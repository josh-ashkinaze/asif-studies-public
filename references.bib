	title        = {The All-Affected Principle: A Pathway to Democracy for the Twenty-First Century?},
	shorttitle   = {The All-Affected Principle},
	author       = {Fung, Archon and Gray, Sean W. D.},
	booktitle    = {Empowering Affected Interests: Democratic Inclusion in a Globalized World},
	location     = {Cambridge},
