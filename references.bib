	isbn         = {978-1-60558-559-8},
	url          = {https://dl.acm.org/doi/10.1145/1621995.1622051},
	urldate      = {2024-06-05},
	eventtitle   = {{SIGDOC} '09: The 27th {ACM} International Conference on Design of Communication},
	date         = {2009-10-05},
