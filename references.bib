@incollection{mansbridge_everyday_1999,
	title        = {Everyday Talk in the Deliberative System},
	author       = {Mansbridge, Jane},
	booktitle    = {Deliberative Politics: Essays on Democracy and Disagreement},
	publisher    = {Oxford University Press},
	pages        = {0},
	doi          = {10.1093/oso/9780195131918.003.0016},
	isbn         = {978-0-19-513191-8},
	url          = {https://doi.org/10.1093/oso/9780195131918.003.0016},
	urldate      = {2026-06-06},
	abstract     = {What I will call “everyday talk” does not meet all of the criteria implicit in the ordinary use of the word “deliberation.” It is not always self-conscious, reflective, or considered. But everyday talk, if not always deliberative, is nevertheless a crucial part of the full deliberative system that democracies need if citizens are, in any sense, to rule themselves. Through talk among formal and informal representatives in designated public forums, talk back and forth between constituents and elected representatives or other representatives in politically oriented organizations, talk in the media, talk among political activists, and everyday talk in formally private spaces about things the public ought to discuss-all adding up to what I call the deliberative system—people come to understand better what they want and need, individually as well as collectively. The full deliberative system encompasses all these strands.},
	editor       = {Macedo, Stephen},
	date         = {1999-08-26}
}
@incollection{mansbridge_systemic_2012,
	title        = {A systemic approach to deliberative democracy},
	author       = {Mansbridge, Jane and Bohman, James and Chambers, Simone and Christiano, Thomas and Fung, Archon and Parkinson, John and Thompson, Dennis F. and Warren, Mark E.},
	booktitle    = {Deliberative Systems: Deliberative Democracy at the Large Scale},
	publisher    = {Cambridge University Press},
	series       = {Theories of Institutional Design},
	pages        = {1--26},
	url          = {https://www.cambridge.org/core/books/deliberative-systems/systemic-approach-to-deliberative-democracy/B7C5BC1B4959B5E470CE77260AE52DE8},
	abstract     = {gpt: Democratic deliberation is often studied as something that happens in a single forum, such as a legislature, citizens’ jury, public meeting, or online discussion. This article argues that this focus is too narrow. No single forum can carry the full burden of democratic legitimacy. Instead, deliberation should be understood as a system made up of many connected parts, including legislatures, courts, media, experts, activists, interest groups, social movements, and everyday public talk. These parts may each have weaknesses, but together they can support better democratic decision-making. A systemic approach asks how different sites of communication divide labor, correct one another, include excluded voices, and shape public judgment over time. The article identifies three key functions of a healthy deliberative system: producing well-informed decisions, fostering mutual respect, and enabling inclusive participation. It also shows how practices often seen as hostile to deliberation—such as protest, partisanship, expert authority, and political media—can sometimes improve the broader system, even when they fall short of deliberative ideals on their own. The article concludes that deliberative democracy should be evaluated not only by the quality of individual discussions, but by how well the whole system works.},
	editor       = {Parkinson, John and Mansbridge, {JaneEditors}},
	date         = 2012
}
